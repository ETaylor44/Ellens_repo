

{{!-- Body --}}
<div class="container bg-light p-4">
    <h1 class="text-center">Score Library</h1>  
    <p>A central hub for all of your music score needs!</p> 

    {{!-- Top picks for you section --}}
    <div class="my-5">
        <div>
            <h2 class="text-center">Top Picks For You</h2>
        </div>
        
        <div class="row d-flex justify-content-center">
            {{#each pieceOfMusic}}
            <div class="card m-3" style="width: 18rem;">
                <div class="forYouImgSize">
                    <img src="{{this.imgExt}}.png" class="card-img-top" alt="Image 1">
                </div>
                <div class="card-body p-1 pb-3">
                    <h5 class="card-title">{{this.composer}}</h5>
                    <div class="titleDivHeight">
                        <p class="card-text">{{this.title}}</p>
                    </div>
                    <a href="/score" class="btn btn-success">View Music</a>
                </div>
            </div>
            {{/each}}
        </div>
    </div>


    <div class="border-top mt-5">
        {{> paragraph title = "Brahms"}}
    </div>
</div>

